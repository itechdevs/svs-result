DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Sync Service (Push-based from Dhalpa School)
# Shared secret for authenticating sync events from dhalpa-school
SYNC_SERVICE_SECRET="your-shared-sync-secret-generate-with-openssl-rand-base64-32"

# ==============================================================================
# DEPRECATED: Old pull-based sync (will be removed after cutover)
# ==============================================================================
# External API (Dhalpa School) - DEPRECATED
# EXTERNAL_API_URL="http://localhost:4000"
# EXTERNAL_API_KEY="your-api-key"

# Cron Job Secret - DEPRECATED
# CRON_SECRET="your-cron-secret-key"

# Auto-Sync Scheduler - DEPRECATED
# Set to "false" after migrating to push-based sync
# AUTO_SYNC_ENABLED="false"
# AUTO_SYNC_INTERVAL_MINUTES="30"

# Gmail SMTP
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# Cloudflare R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="your-r2-bucket"

# Docker service names
POSTGRES_SERVICE=postgres
APP_SERVICE=web-service
