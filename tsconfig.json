{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["./src/utils/index.ts"],
      "@/lib/constants": ["./src/constants/index.ts"],
      "@/lib/auth": ["./src/services/auth.ts"],
      "@/lib/mockData": ["./src/constants/mockData.ts"],
      "@/components/ui/*": ["./src/components/shared/ui/*"],
      "@/components/common/*": ["./src/components/shared/common/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
