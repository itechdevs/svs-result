generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum ResultStatus {
  PROMOTED
  FAILED
  PROBATION
  WITHHELD
  UNDER_REVIEW
  PENDING
}

enum MarksEntryStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  PUBLISHED
  LOCKED
}

enum ReExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum GradeType {
  LETTER // A, B, C, D
  PERCENTAGE // 0-100
  GPA // 4.0 scale
  DESCRIPTIVE // Excellent, Good, etc.
}

model Class {
  id          String    @id @default(uuid())
  name        String // "Grade 1", "Class 10", "KG"
  displayName String // "First Grade", "Tenth Standard"
  level       Int // 1, 2, 3... for ordering
  isActive    Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  gradeScales     GradeScale[]
  evaluationPlans EvaluationPlan[]
  exams           Exam[]

  @@unique([name])
  @@unique([level])
  @@index([level, isActive])
  @@map("classes")
}

model Subject {
  id          String    @id @default(uuid())
  code        String    @unique // "MATH101", "ENG102"
  name        String // "Mathematics", "English"
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  evaluationPlans EvaluationPlan[]
  subjectResults  SubjectResult[]

  @@index([code])
  @@index([isActive])
  @@map("subjects")
}

// ============================================================================
// 2. USER MANAGEMENT
// ============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  firstName    String
  phoneNumber  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  teacher Teacher?
  student Student?

  @@index([email])
  @@index([role, isActive])
  @@map("users")
}

model Teacher {
  id         String    @id @default(uuid())
  userId     String    @unique
  employeeId String    @unique
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  marksEntries MarksEntry[]

  @@index([employeeId])
  @@index([isActive])
  @@map("teachers")
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  admissionDate DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentEvaluations StudentEvaluation[]
  marksEntries       MarksEntry[]
  subjectResults     SubjectResult[]
  termResults        TermResult[]
  finalResults       FinalResult[]
  reExamMarks        ReExamMarks[]
  marksheets         Marksheet[]

  @@index([isActive])
  @@map("students")
}

// ============================================================================
// 5. EVALUATION SYSTEM
// ============================================================================

model EvaluationPlan {
  id             String    @id @default(uuid())
  subjectId      String
  classId        String
  sectionId      String? // NULL = applies to all sections in class
  name           String // "First Term Exam", "Unit Test 1"
  fullMarks      Decimal   @db.Decimal(6, 2)
  passMarks      Decimal   @db.Decimal(6, 2)
  weightage      Decimal?  @db.Decimal(5, 2) // Percentage contribution to final
  scheduledDate  DateTime?
  description    String?
  isOutcomeBased Boolean   @default(true)
  displayOrder   Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentEvaluations StudentEvaluation[]
  marksEntries       MarksEntry[]
  reExamSchedules    ReExamSchedule[]

  @@unique([subjectId, classId, sectionId, name])
  @@index([subjectId])
  @@index([classId, subjectId])
  @@map("evaluation_plans")
}

model StudentEvaluation {
  id               String           @id @default(uuid())
  studentId        String
  evaluationPlanId String
  totalMarks       Decimal?         @db.Decimal(6, 2) // Computed field, can be null if not yet calculated
  obtainedMarks    Decimal?         @db.Decimal(6, 2)
  status           MarksEntryStatus @default(DRAFT)
  isPassed         Boolean?
  remarks          String?
  absentFlag       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Relations
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluationPlan EvaluationPlan        @relation(fields: [evaluationPlanId], references: [id], onDelete: Cascade)
  outcomeMarks   StudentOutcomeMarks[]

  @@unique([studentId, evaluationPlanId])
  @@index([studentId])
  @@index([evaluationPlanId])
  @@index([status])
  @@map("student_evaluations")
}

model StudentOutcomeMarks {
  id                  String    @id @default(uuid())
  studentEvaluationId String
  learningOutcomeId   String
  regularMarks        Decimal?  @db.Decimal(6, 2) // Initial attempt marks
  regularDate         DateTime? // When regular marks were entered
  supportMarks        Decimal?  @db.Decimal(6, 2) // After-support marks
  supportDate         DateTime? // When support marks were entered
  maxMarks            Decimal   @db.Decimal(6, 2)
  passMarks           Decimal   @db.Decimal(6, 2)
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  studentEvaluation StudentEvaluation @relation(fields: [studentEvaluationId], references: [id], onDelete: Cascade)

  @@unique([studentEvaluationId, learningOutcomeId])
  @@index([studentEvaluationId])
  @@map("student_outcome_marks")
}

model MarksEntry {
  id               String           @id @default(uuid())
  studentId        String
  evaluationPlanId String
  teacherId        String
  marksObtained    Decimal          @db.Decimal(6, 2)
  fullMarks        Decimal          @db.Decimal(6, 2)
  attemptNumber    Int              @default(1) // 1 = regular, 2+ = re-exam
  isReExam         Boolean          @default(false)
  status           MarksEntryStatus @default(DRAFT)
  entryDate        DateTime         @default(now())
  verifiedBy       String? // User ID
  verifiedAt       DateTime?
  remarks          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  // Relations
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluationPlan EvaluationPlan @relation(fields: [evaluationPlanId], references: [id], onDelete: Cascade)
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([studentId, evaluationPlanId, attemptNumber])
  @@index([studentId, evaluationPlanId])
  @@index([teacherId])
  @@index([status])
  @@map("marks_entries")
}

// ============================================================================
// 7. RESULT PROCESSING
// ============================================================================

model Exam {
  id          String            @id @default(uuid())
  name        String // "First Term Exam 2024", "Final Exam 2024"
  classId     String // Which class this exam is for
  examDate    DateTime
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  publishedBy String? // User ID
  remarks     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  finalResults FinalResult[]

  @@unique([classId, name])
  @@index([classId, status])
  @@map("exams")
}

model GradeScale {
  id          String    @id @default(uuid())
  classId     String // Which class this scale applies to
  name        String // "Standard Grading", "IB Grading"
  gradeType   GradeType
  minPercent  Decimal   @db.Decimal(5, 2)
  maxPercent  Decimal   @db.Decimal(5, 2)
  grade       String // "A+", "A", "B+", etc.
  gradePoint  Decimal?  @db.Decimal(3, 2) // For GPA calculation
  description String? // "Excellent", "Very Good", etc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, minPercent, maxPercent])
  @@index([classId, isActive])
  @@map("grade_scales")
}

model SubjectResult {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  termResultId  String? // Optional: link to term result
  totalMarks    Decimal  @db.Decimal(6, 2)
  obtainedMarks Decimal  @db.Decimal(6, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  grade         String?
  gradePoint    Decimal? @db.Decimal(3, 2)
  isPassed      Boolean
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termResult TermResult? @relation(fields: [termResultId], references: [id], onDelete: SetNull)

  @@unique([studentId, termResultId, subjectId])
  @@index([studentId])
  @@index([termResultId])
  @@map("subject_results")
}

model TermResult {
  id            String   @id @default(uuid())
  studentId     String
  finalResultId String? // Link to final result
  termName      String // "First Term", "Second Term"
  totalMarks    Decimal  @db.Decimal(8, 2)
  obtainedMarks Decimal  @db.Decimal(8, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  gpa           Decimal? @db.Decimal(3, 2)
  grade         String?
  rank          Int?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  finalResult    FinalResult?    @relation(fields: [finalResultId], references: [id], onDelete: SetNull)
  subjectResults SubjectResult[]

  @@unique([studentId, finalResultId, termName])
  @@index([studentId])
  @@index([finalResultId])
  @@map("term_results")
}

model FinalResult {
  id                String       @id @default(uuid())
  studentId         String
  examId            String
  totalMarks        Decimal      @db.Decimal(8, 2)
  obtainedMarks     Decimal      @db.Decimal(8, 2)
  percentage        Decimal      @db.Decimal(5, 2)
  cgpa              Decimal?     @db.Decimal(3, 2)
  grade             String?
  rank              Int? // Class rank
  overallRank       Int? // Grade-wide rank
  resultStatus      ResultStatus @default(PENDING)
  attendancePercent Decimal?     @db.Decimal(5, 2)
  remarks           String?
  publishedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  termResults TermResult[]

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([resultStatus])
  @@map("final_results")
}

// ============================================================================
// 8. RE-EXAMINATION SYSTEM
// ============================================================================

model ReExamSchedule {
  id               String       @id @default(uuid())
  evaluationPlanId String
  attemptNumber    Int // 2, 3, etc.
  scheduledDate    DateTime
  startDate        DateTime? // Marks entry window
  endDate          DateTime?
  status           ReExamStatus @default(SCHEDULED)
  fullMarks        Decimal      @db.Decimal(6, 2)
  passMarks        Decimal      @db.Decimal(6, 2)
  remarks          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  // Relations
  evaluationPlan EvaluationPlan @relation(fields: [evaluationPlanId], references: [id], onDelete: Cascade)
  reExamMarks    ReExamMarks[]

  @@unique([evaluationPlanId, attemptNumber])
  @@index([evaluationPlanId])
  @@index([scheduledDate])
  @@map("re_exam_schedules")
}

model ReExamMarks {
  id               String   @id @default(uuid())
  reExamScheduleId String
  studentId        String
  marksObtained    Decimal  @db.Decimal(6, 2)
  isPassed         Boolean
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  reExamSchedule ReExamSchedule @relation(fields: [reExamScheduleId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([reExamScheduleId, studentId])
  @@index([reExamScheduleId])
  @@index([studentId])
  @@map("re_exam_marks")
}

// ============================================================================
// 9. REPORTING & PUBLICATION
// ============================================================================

model Marksheet {
  id          String   @id @default(uuid())
  studentId   String
  generatedBy String // User ID
  generatedAt DateTime @default(now())
  fileUrl     String? // Path to generated PDF
  metadata    Json? // Additional data (subjects, grades, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([generatedAt])
  @@map("marksheets")
}

model ResultPublication {
  id          String            @id @default(uuid())
  classId     String? // NULL = all classes
  publishDate DateTime
  status      PublicationStatus @default(DRAFT)
  publishedBy String? // User ID
  remarks     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([publishDate])
  @@index([status])
  @@map("result_publications")
}
