### 2.7 Secondary Marksheet

```prisma
model SecondaryMarksheet {
  id              String   @id @default(cuid())
  syncedStudentId String
  termResultId    String?  @unique // For term marksheet
  annualResultId  String?  @unique // For annual marksheet
  examId          String?
  academicYearId  String
  generatedById   String
  generatedAt     DateTime @default(now())
  fileUrl         String?
  metadata        Json     // Full snapshot
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncedStudent  SyncedStudent         @relation(fields: [syncedStudentId], references: [id], onDelete: Cascade)
  termResult     SecondaryTermResult?  @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  annualResult   SecondaryAnnualResult? @relation("AnnualMarksheet", fields: [annualResultId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  generatedBy    User                  @relation("SecGeneratedBy", fields: [generatedById], references: [id])

  @@map("secondary_marksheets")
}
```

