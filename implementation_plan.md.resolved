### 2.5 Term-Scoped Subject & Final Results

```prisma
/// Per-subject result within a single term/exam
model SecondarySubjectResult {
  id              String   @id @default(cuid())
  syncedStudentId String
  subjectConfigId String
  examId          String
  internalMarks   Decimal? @db.Decimal(6, 2)
  theoryMarks     Decimal? @db.Decimal(6, 2)
  practicalMarks  Decimal? @db.Decimal(6, 2)
  totalObtained   Decimal  @db.Decimal(8, 2)
  totalFullMarks  Decimal  @db.Decimal(8, 2)
  percentage      Decimal  @db.Decimal(5, 2)
  grade           String
  gradePoint      Decimal  @db.Decimal(3, 2)
  isNG            Boolean  @default(false)
  creditHours     Int
  weightedPoint   Decimal  @db.Decimal(6, 2) // creditHours × gradePoint
  remarks         String?
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncedStudent  SyncedStudent          @relation(fields: [syncedStudentId], references: [id], onDelete: Cascade)
  subjectConfig  SecondarySubjectConfig @relation(fields: [subjectConfigId], references: [id], onDelete: Cascade)
  exam           Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  finalResult    SecondaryTermResult?   @relation(fields: [finalResultId], references: [id])
  finalResultId  String?

  @@unique([syncedStudentId, subjectConfigId, examId])
  @@map("secondary_subject_results")
}

/// Per-student result for a single term with credit-hour-weighted GPA
model SecondaryTermResult {
  id              String       @id @default(cuid())
  syncedStudentId String
  examId          String
  academicYearId  String
  totalSubjects   Int
  passedSubjects  Int
  ngSubjects      Int
  totalCreditHours Int
  totalWeightedPoints Decimal  @db.Decimal(8, 2)
  gpa             Decimal      @db.Decimal(4, 2)
  classRank       Int?
  resultStatus    ResultStatus @default(PENDING)
  hasNG           Boolean      @default(false)
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  publishedById   String?
  remarks         String?
  computedAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  syncedStudent   SyncedStudent            @relation(fields: [syncedStudentId], references: [id], onDelete: Cascade)
  exam            Exam                     @relation(fields: [examId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  publishedBy     User?                    @relation("SecPublishedBy", fields: [publishedById], references: [id])
  subjectResults  SecondarySubjectResult[]
  marksheet       SecondaryMarksheet?

  @@unique([syncedStudentId, examId])
  @@index([examId, resultStatus])
  @@map("secondary_term_results")
}
```

---

### 2.6 Annual Final Result (Weighted from Terms)

The annual result is computed by taking **configured percentage weights from each term** (e.g. First 10%, Second 15%, Third 20%, Final 55%).

```prisma
/// Admin configures how each term contributes to the annual result
model SecondaryTermWeight {
  id             String  @id @default(cuid())
  academicYearId String
  gradeLevel     String
  examId         String  // The term exam
  termName       String  // "First Term", "Second Term", etc.
  weightPercent  Decimal @db.Decimal(5, 2) // Must sum to 100 across all terms
  displayOrder   Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, gradeLevel, examId])
  @@map("secondary_term_weights")
}

/// Annual result — weighted aggregation of all term results
model SecondaryAnnualResult {
  id              String       @id @default(cuid())
  syncedStudentId String
  academicYearId  String
  totalSubjects   Int
  passedSubjects  Int
  ngSubjects      Int
  totalCreditHours Int
  totalWeightedPoints Decimal  @db.Decimal(8, 2)
  gpa             Decimal      @db.Decimal(4, 2) // Credit-hour weighted
  classRank       Int?
  resultStatus    ResultStatus @default(PENDING)
  hasNG           Boolean      @default(false)
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  publishedById   String?
  remarks         String?
  computedAt      DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  syncedStudent   SyncedStudent @relation(fields: [syncedStudentId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  publishedBy     User?         @relation("SecAnnualPublishedBy", fields: [publishedById], references: [id])
  subjectResults  SecondaryAnnualSubjectResult[]
  marksheet       SecondaryMarksheet? @relation("AnnualMarksheet")

  @@unique([syncedStudentId, academicYearId])
  @@map("secondary_annual_results")
}

/// Per-subject annual result — weighted average from term subject results
model SecondaryAnnualSubjectResult {
  id              String  @id @default(cuid())
  annualResultId  String
  subjectConfigId String
  syncedStudentId String
  // Weighted marks from each term
  weightedTotalObtained Decimal @db.Decimal(8, 2)
  weightedTotalFull     Decimal @db.Decimal(8, 2)
  percentage            Decimal @db.Decimal(5, 2)
  grade                 String
  gradePoint            Decimal @db.Decimal(3, 2)
  isNG                  Boolean @default(false)
  creditHours           Int
  weightedPoint         Decimal @db.Decimal(6, 2)
  remarks               String?
  computedAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  annualResult   SecondaryAnnualResult  @relation(fields: [annualResultId], references: [id], onDelete: Cascade)
  subjectConfig  SecondarySubjectConfig @relation(fields: [subjectConfigId], references: [id], onDelete: Cascade)
  syncedStudent  SyncedStudent          @relation(fields: [syncedStudentId], references: [id], onDelete: Cascade)

  @@unique([annualResultId, subjectConfigId])
  @@map("secondary_annual_subject_results")
}
```

**Annual computation logic:**

```
For each subject:
  weightedObtained = Σ(termSubjectResult.totalObtained × termWeight.weightPercent / 100)
  weightedFull     = Σ(termSubjectResult.totalFullMarks × termWeight.weightPercent / 100)
  percentage       = weightedObtained / weightedFull × 100
  → Look up grade/GP from SecondaryGradeScale
  → isNG if grade == "NG"

GPA = Σ(creditHours × gradePoint) / Σ(creditHours)
resultStatus = hasNG ? NG_BLOCKED : PROMOTED
```

